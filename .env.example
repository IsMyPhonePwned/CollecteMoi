# Copy to .env and adjust for docker compose.
COLLECTEMOI_PORT=8080
COLLECTEMOI_HTTP_PORT=8081
COLLECTEMOI_PUBLIC_URL=https://127.0.0.1:8080
COLLECTEMOI_LAB_SEAL=true
COLLECTEMOI_WORKER_POLL_SECS=2
# Release label baked into the image and shown in the admin UI (sidebar + overview).
# COLLECTEMOI_VERSION=1.4.0
# COLLECTEMOI_DOCKER_TAG=collectemoi:1.4.0
# Android cmdline-tools are x86_64 — keep amd64 on Apple Silicon.
COLLECTEMOI_DOCKER_PLATFORM=linux/amd64
# Persistent lab data (SQLite, uploads, TLS, keys). Survives image upgrades.
# Created by ./scripts/collectemoi-docker; wipe only with wipe-data --yes.
COLLECTEMOI_DOCKER_VOLUME=collectemoi-data
# COLLECTEMOI_OTP_WEBHOOK_URL=https://mail.example/hooks/collectemoi-otp
# COLLECTEMOI_OTP_WEBHOOK_TOKEN=
